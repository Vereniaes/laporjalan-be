# Server Port (Cloud Run default 8080, local testing 5000)
PORT=5000
NODE_ENV=development
# Use true for the public map release: no database, seeds, uploads or legacy write routes.
PUBLIC_REPORTS_ONLY=true

# MongoDB Connection String (Atlas or Local)
# Kosongkan atau beri nilai jika ingin fallback in-memory untuk tes lokal
MONGODB_URI=mongodb://localhost:27017/laporjalan

# Google Cloud Storage (Opsional: jika kosong akan fallback simpan ke /uploads lokal)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=

# CORS Origin
CORS_ORIGIN=*

# Community reports - keep legacy routes disabled
COMMUNITY_REPORTS_ENABLED=false
# Required when community reports are enabled; use the Vercel origin
APP_ORIGIN=https://YOUR-FRONTEND.vercel.app
# Store in Secret Manager, never VITE_*
RESEND_API_KEY=
EMAIL_FROM=LaporJalan <masuk@YOUR-VERIFIED-DOMAIN>
